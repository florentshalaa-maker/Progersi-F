<style>
:root{
  --bg:#F3F6F2;--surface:#FFFFFF;--surface2:#E6EEE7;--ink:#14231B;--muted:#5C6B62;
  --green:#2E6B4F;--green-2:#3F8A66;--mint:#CFE6D8;--rose:#C2544A;--line:#D5E0D8;
  --font:"Figtree",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0F1712;--surface:#18231C;--surface2:#203027;--ink:#E7F0EA;--muted:#9AAEA2;
  --green:#6CC499;--green-2:#8AD6AE;--mint:#264536;--rose:#E58377;--line:#2C3E33;}}
:root[data-theme="dark"]{--bg:#0F1712;--surface:#18231C;--surface2:#203027;--ink:#E7F0EA;--muted:#9AAEA2;
  --green:#6CC499;--green-2:#8AD6AE;--mint:#264536;--rose:#E58377;--line:#2C3E33;}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.45;-webkit-font-smoothing:antialiased}
main{max-width:560px;margin:0 auto;padding:18px 16px 110px}
h1{font-size:1.55rem;font-weight:800;margin:0;letter-spacing:-.01em}
h2{font-size:1.1rem;font-weight:700;margin:22px 0 10px}
p{margin:0}
.muted{color:var(--muted)}
.small{font-size:.86rem}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--green-2);outline-offset:2px}
.top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-bottom:14px}
.sync{font-size:.78rem;color:var(--muted);text-align:right}
.hero{background:var(--green);color:#fff;border-radius:22px;padding:20px;position:relative;overflow:hidden}
:root[data-theme="dark"] .hero{color:#0F1712}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .hero{color:#0F1712}}
.hero .big{font-size:3.1rem;font-weight:800;line-height:1;letter-spacing:-.02em}
.hero .big small{font-size:1.1rem;font-weight:600;margin-left:4px}
.hero .row{display:flex;justify-content:space-between;align-items:flex-end;gap:10px}
.track{height:10px;background:rgba(255,255,255,.28);border-radius:99px;margin-top:16px;overflow:hidden}
.track i{display:block;height:100%;background:currentColor;border-radius:99px;transition:width .5s}
.hero .meta{display:flex;justify-content:space-between;font-size:.82rem;margin-top:6px;opacity:.9}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px}
.stack>*+*{margin-top:10px}
.check{display:flex;align-items:center;gap:12px;width:100%;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 14px;text-align:left}
.check .box{flex:0 0 26px;height:26px;border-radius:8px;border:2px solid var(--line);display:grid;place-items:center;transition:background .15s}
.check.on .box{background:var(--green);border-color:var(--green)}
.check.on .box::after{content:"";width:7px;height:13px;border:solid var(--surface);border-width:0 3px 3px 0;transform:rotate(45deg) translate(-1px,-1px)}
.check .t{flex:1}
.check .t b{display:block;font-weight:600}
.check .time{font-size:.8rem;color:var(--muted);font-variant-numeric:tabular-nums}
.water{display:flex;gap:6px;margin-top:10px}
.water button{flex:1;height:44px;border-radius:10px;border:1.5px solid var(--line);background:var(--surface2);position:relative;overflow:hidden}
.water button.on{background:var(--green);border-color:var(--green)}
.datebar{display:flex;align-items:center;justify-content:space-between;margin:18px 0 6px}
.datebar button{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--surface);font-size:1.2rem}
.datebar strong{font-weight:700}
.pill{display:inline-block;padding:3px 10px;border-radius:99px;background:var(--mint);color:var(--ink);font-size:.8rem;font-weight:600}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:46px;padding:0 18px;border-radius:13px;border:0;background:var(--green);color:var(--surface);font-weight:700}
.btn.ghost{background:transparent;color:var(--green);border:1.5px solid var(--green)}
.btn.danger{background:transparent;color:var(--rose);border:1.5px solid var(--rose)}
.btn.full{width:100%}
.seg{display:flex;background:var(--surface2);border-radius:13px;padding:4px;gap:4px}
.seg button{flex:1;border:0;background:transparent;border-radius:10px;min-height:40px;font-weight:600;color:var(--muted)}
.seg button.on{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
label.f{display:block;font-size:.84rem;color:var(--muted);font-weight:600}
input.in{width:100%;margin-top:4px;min-height:46px;border-radius:12px;border:1.5px solid var(--line);background:var(--surface);padding:0 12px;font-size:1rem}
input.in:focus{border-color:var(--green)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.ex{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px}
.ex h3{margin:0;font-size:1rem;font-weight:700}
.ex .hint{font-size:.82rem;color:var(--muted);margin-top:2px}
.sets{display:grid;grid-template-columns:auto 1fr 1fr;gap:6px 10px;align-items:center;margin-top:10px}
.sets .n{font-size:.8rem;color:var(--muted);font-weight:600;min-width:46px;white-space:nowrap}
.sets input{min-height:42px;border-radius:10px;border:1.5px solid var(--line);background:var(--surface2);text-align:center;font-size:1rem;width:100%}
.sets .hd{font-size:.74rem;color:var(--muted);text-align:center}
.last{font-size:.8rem;color:var(--muted);margin-top:8px}
.up{font-size:.82rem;color:var(--green);font-weight:700;margin-top:6px}
.list{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--surface)}
.list .it{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-top:1px solid var(--line);gap:10px}
.list .it:first-child{border-top:0}
.list .it .v{font-weight:700;font-variant-numeric:tabular-nums}
.del{border:0;background:transparent;color:var(--muted);font-size:1.1rem;width:34px;height:34px;border-radius:10px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px}
.stat b{display:block;font-size:1.4rem;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.1}
.stat span{font-size:.76rem;color:var(--muted)}
.chart{width:100%;height:auto;display:block}
.chart text{font-family:var(--font);fill:var(--muted);font-size:11px}
nav.tabs{position:fixed;left:0;right:0;bottom:0;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px);z-index:5}
nav.tabs .in{max-width:560px;margin:0 auto;display:flex}
nav.tabs button{flex:1;border:0;background:transparent;padding:9px 0 10px;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:.74rem;font-weight:600;color:var(--muted)}
nav.tabs button svg{width:24px;height:24px}
nav.tabs button.on{color:var(--green)}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;font-size:.9rem;font-weight:600;opacity:0;transition:.25s;pointer-events:none;z-index:9}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.empty{text-align:center;padding:24px 12px;color:var(--muted)}
.rest{background:var(--surface2);border-radius:16px;padding:16px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
