  var d=pts.map(function(p,i){return (i?"L":"M")+sx(p.x).toFixed(1)+" "+sy(p.y).toFixed(1);}).join(" ");
  var g="";for(var i=0;i<=3;i++){var yv=mn+(mx-mn)*i/3,yy=sy(yv);g+='<line x1="'+pl+'" x2="'+(W-pr)+'" y1="'+yy+'" y2="'+yy+'" stroke="var(--line)"/><text x="'+(pl-6)+'" y="'+(yy+4)+'" text-anchor="end">'+Math.round(yv)+'</text>';}
  var tg=opt.target!=null?'<line x1="'+pl+'" x2="'+(W-pr)+'" y1="'+sy(opt.target)+'" y2="'+sy(opt.target)+'" stroke="var(--green-2)" stroke-dasharray="4 4"/><text x="'+(W-pr)+'" y="'+(sy(opt.target)-5)+'" text-anchor="end" style="fill:var(--green)">'+opt.tlabel+'</text>':"";
  var dots=pts.map(function(p){return '<circle cx="'+sx(p.x)+'" cy="'+sy(p.y)+'" r="3.5" fill="var(--green)"/>';}).join("");
  var lab='<text x="'+pl+'" y="'+(H-6)+'">'+pts[0].l+'</text><text x="'+(W-pr)+'" y="'+(H-6)+'" text-anchor="end">'+pts[pts.length-1].l+'</text>';
  return '<svg class="chart" viewBox="0 0 '+W+' '+H+'" role="img" aria-label="'+opt.aria+'">'+g+tg+'<path d="'+d+'" fill="none" stroke="var(--green)" stroke-width="2.5" stroke-linejoin="round"/>'+dots+lab+'</svg>';
