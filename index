document.getElementById("tabs").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;ui.tab=b.dataset.tab;render();window.scrollTo(0,0);});
document.getElementById("app").addEventListener("input",function(e){
  var el=e.target;
  if(el.dataset.ex){var dr=ui.draft;if(!dr.ex[el.dataset.ex])dr.ex[el.dataset.ex]=[];var arr=dr.ex[el.dataset.ex],i=+el.dataset.i;while(arr.length<=i)arr.push({});arr[i][el.dataset.k]=num(el.value);}
  if(el.dataset.act==="note")ui.draft.note=el.value;
});
document.getElementById("app").addEventListener("click",function(e){
  var b=e.target.closest("[data-act]");if(!b||b.tagName==="INPUT")return;var a=b.dataset.act,t=L();
  if(a==="pickSes")openSession(b.dataset.s,today());
  else if(a==="cancelSes"){ui.wkSession=null;ui.draft=null;render();}
  else if(a==="saveSes"){
    var dr=ui.draft,clean={};
    Object.keys(dr.ex).forEach(function(k){if(dr.ex[k].some(function(x){return x&&(x.kg!=null||x.r!=null);}))clean[k]=dr.ex[k].map(function(x){return {kg:x&&x.kg!=null?x.kg:null,r:x&&x.r!=null?x.r:null};});});
    if(!Object.keys(clean).length){toast(t.oneSet);return;}
    S.workouts=S.workouts.filter(function(w){return w.date!==dr.date;});
    S.workouts.push({date:dr.date,session:dr.session,ex:clean,note:dr.note||""});
    save();ui.wkSession=null;ui.draft=null;render();toast(t.sessionSaved);
  }
  else if(a==="delWo"){if(confirm(t.confirmDelSession)){S.workouts=S.workouts.filter(function(w){return w.date!==b.dataset.d;});save();render();}}
  else if(a==="addW"){
    var d=document.getElementById("wDate").value||today(),kg=num(document.getElementById("wKg").value),wa=num(document.getElementById("wWaist").value);
    if(kg==null||kg<35||kg>250){toast(t.enterWeight);return;}
    S.weights=S.weights.filter(function(x){return x.date!==d;});S.weights.push({date:d,kg:kg,waist:wa});save();render();toast(t.measureSaved);
  }
  else if(a==="delW"){if(confirm(t.confirmDelMeasure)){S.weights=S.weights.filter(function(x){return x.date!==b.dataset.d;});save();render();}}
  else if(a==="saveSet"){var sd=document.getElementById("sStart").value,sw=num(document.getElementById("sW").value);if(sd)S.start=sd;if(sw)S.startWeight=sw;save();render();toast(t.saved);}
  else if(a==="lang"){LANG=b.dataset.l;try{localStorage.setItem(KEY+"-lang",LANG);}catch(_){}render();}
  else if(a==="export")doExport();
  else if(a==="import")document.getElementById("importFile").click();
  else if(a==="theme"){if(b.dataset.t)document.documentElement.dataset.theme=b.dataset.t;else delete document.documentElement.dataset.theme;try{localStorage.setItem(KEY+"-theme",b.dataset.t);}catch(_){}render();}
  else if(a==="reset"){if(confirm(t.confirmWipe)){var st=S.start,sw2=S.startWeight;S=blank();S.start=st;S.startWeight=sw2;save();render();toast(t.wiped);}}
});
function doExport(){
  var t=L(),p=window.claude&&window.claude.use?window.claude.use("downloads"):Promise.resolve(null);
  p.then(function(dl){
    if(!dl){
      try{var blob=new Blob([JSON.stringify(S,null,2)],{type:"application/json"}),u=URL.createObjectURL(blob),a=document.createElement("a");
        a.href=u;a.download="florentina-progresi-"+today()+".json";document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(u);},2000);toast(t.downloaded);}
      catch(_){toast(t.noDownload);}
      return;}
    return dl.save({filename:"florentina-progresi-"+today()+".json",data:JSON.stringify(S,null,2)}).then(function(){toast(t.downloaded);}).catch(function(){});
  });
}
document.getElementById("importFile").addEventListener("change",function(e){
  var f=e.target.files[0];if(!f)return;var r=new FileReader();
  r.onload=function(){try{var o=JSON.parse(r.result);if(!o||!Array.isArray(o.weights)||!Array.isArray(o.workouts))throw 0;S=Object.assign(blank(),o);save();render();toast(L().imported);}catch(_){toast(L().badFile);}};
  r.readAsText(f);e.target.value="";
});
try{var th=localStorage.getItem(KEY+"-theme");if(th)document.documentElement.dataset.theme=th;}catch(_){}

render();

/* ---------- cloud sync (private per person) ---------- */
if(window.claude&&window.claude.use){
  Promise.all([window.claude.use("db"),window.claude.use("user")]).then(function(r){
    var db=r[0],user=r[1];if(!db||!user)return;
    return user.id().then(function(uid){
      if(!uid)return;
      var ref=db.doc("data/users/"+uid+"/plan");
      return ref.get().then(function(snap){
        dbRef=ref;
        if(snap.exists){var remote=snap.data()||{};
          if((remote.updatedAt||0)>=(S.updatedAt||0)){S=Object.assign(blank(),JSON.parse(JSON.stringify(remote)));try{localStorage.setItem(KEY,JSON.stringify(S));}catch(_){}setSync("cloud");if(!ui.wkSession)render();}
          else pushDb();
        }else if(S.updatedAt)pushDb();else setSync("cloud");
      });
    });
  }).catch(function(){dbRef=null;setSync("local");});
}
})();

</script>
</body>
</html>
